SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Sync destination (drive root / library folder / collection folders)
DJSYNC_DRIVE=/Volumes/BRIANB
DJSYNC_LIBRARY_ROOT=dj
DJSYNC_PLAYLISTS_DIR=playlists
DJSYNC_ALBUMS_DIR=albums
# DJSYNC_COLLECTION is deprecated; use DJSYNC_PLAYLISTS_DIR instead.

# Unattended agent (optional)
# DJSYNC_DAILY_DOWNLOAD_CAP=800
# DJSYNC_STALE_AFTER_HOURS=12
# DJSYNC_CIRCUIT_BREAKER_FAILURES=5
# DJSYNC_REPORT_EMAIL=brian.rio11@gmail.com
# SECRET: never commit a real token — run `djsync beeper-auth` to obtain one.
# DJSYNC_BEEPER_URL=http://127.0.0.1:23373
# DJSYNC_BEEPER_CHAT_ID=33169
# DJSYNC_BEEPER_TOKEN=
