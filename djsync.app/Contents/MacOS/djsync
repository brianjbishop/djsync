#!/bin/sh
# Finder launcher for djsync.
#
# Starts the local server and opens the UI. Prefers launching the project
# directly, which needs Full Disk Access when the project lives in a
# TCC-protected folder such as ~/Documents. If that is denied, falls back to
# handing the command to Terminal, which already holds that permission.
#
# The bundle is expected to sit in the project root, so the repo is three
# levels up. Keep it there, or make an alias rather than moving it.
REPO=$(cd "$(dirname "$0")/../../.." && pwd)
STATE="$HOME/.djsync"; mkdir -p "$STATE"
URLFILE="$STATE/url"
LOG="$STATE/launch.log"

if [ ! -x "$REPO/djsync-run" ]; then
  osascript -e 'display alert "djsync" message "Could not find djsync-run. Keep djsync.app inside the project folder, or use an alias instead of moving it."'
  exit 1
fi

# Already running? Reopen the UI rather than starting a second server.
if pgrep -f "djsync.cli ui" >/dev/null 2>&1 && [ -s "$URLFILE" ]; then
  open "$(cat "$URLFILE")"
  exit 0
fi

rm -f "$URLFILE" "$LOG"

launch_via_terminal() {
  osascript >/dev/null 2>&1 <<OSA
tell application "Terminal"
  activate
  do script "cd '$REPO' && ./djsync-run ui"
end tell
OSA
  exit 0
}

# Direct launch. The server writes $URLFILE once it is listening.
( cd "$REPO" && ./djsync-run ui ) > "$LOG" 2>&1 &
PID=$!

i=0
while [ $i -lt 90 ]; do
  [ -s "$URLFILE" ] && break
  grep -q "Operation not permitted" "$LOG" 2>/dev/null && launch_via_terminal
  kill -0 "$PID" 2>/dev/null || break
  sleep 1
  i=$((i + 1))
done

if [ ! -s "$URLFILE" ]; then
  grep -q "Operation not permitted" "$LOG" 2>/dev/null && launch_via_terminal
  osascript -e "display alert \"djsync failed to start\" message \"$(tail -4 "$LOG" 2>/dev/null | tr '\"' \"'\")\""
  exit 1
fi

open "$(cat "$URLFILE")"
wait "$PID"
